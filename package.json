{
  "name": "direct-ota",
  "version": "0.4.0",
  "description": "Signed OTA updates for Capacitor apps, on infrastructure you control.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Ibrahim Jaber",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "direct-ota": "cli/index.mjs"
  },
  "exports": {
    ".": "./dist/client/index.js",
    "./protocol": "./dist/protocol.js",
    "./server": "./providers/node/server.mjs"
  },
  "files": [
    "cli",
    "dist",
    "native",
    "providers",
    "src/protocol.ts",
    "docs",
    "skills",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "assets",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:cloudflare": "cd providers/cloudflare && ../../node_modules/.bin/wrangler types && ../../node_modules/.bin/tsc --project tsconfig.json && ../../node_modules/.bin/wrangler deploy --dry-run",
    "check": "npm run typecheck && npm test && npm run check:cloudflare && npm run build",
    "prepack": "npm run check",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@capgo/capacitor-updater": "8.51.25"
  },
  "peerDependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "8.4.3",
    "@capacitor/core": "^8.1.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "wrangler": "4.139.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibsz909i/direct-ota.git"
  },
  "homepage": "https://github.com/ibsz909i/direct-ota#readme",
  "bugs": {
    "url": "https://github.com/ibsz909i/direct-ota/issues"
  },
  "keywords": [
    "ota",
    "capacitor",
    "ios",
    "android",
    "live-updates",
    "self-hosted",
    "capgo"
  ]
}
